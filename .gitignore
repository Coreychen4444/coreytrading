# Runtime scratch
tmp/

# Domain-agent runs, control leases and rollout backups (private)
var/
*.log

# AI private-workspace boundary. Only contracts and synthetic examples are public.
trade/**
!trade/**/
!trade/**/README.md
!trade/**/*.example.*

# Optional user-owned intelligence data lives under trade/intelligence/ and is
# covered by the trade/** rules above; its runtime state lives under var/.

# Optional nested knowledge vault
investment/
